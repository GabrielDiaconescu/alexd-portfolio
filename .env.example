# Copiază în .env.local (local) și în panoul găzduirii (producție). Nu pune niciodată valori reale în acest fișier.

# Adresa finală a site-ului, cu https și fără / la final. Se citește la build (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=

# Formularul de proiect trimite e-mailuri prin Resend (resend.com).
# Fără aceste trei valori, formularul NU pretinde că a trimis: îi arată vizitatorului e-mailul tău ca alternativă.
RESEND_API_KEY=
# Expeditorul, pe un domeniu verificat în Resend. Exemplu de format: Site Alex D. <formular@domeniul-tau.ro>
INQUIRY_FROM_EMAIL=
# Unde primești cererile.
INQUIRY_TO_EMAIL=
