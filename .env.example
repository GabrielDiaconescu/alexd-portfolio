# Copiază în .env.local (local). Nu pune niciodată valori reale în acest fișier.
# Producție: valorile publice stau în .env.production; doar SMTP_PASS se setează în panoul găzduirii
# (panoul Hosterion respinge valorile cu @, spații sau <>).

# Adresa finală a site-ului, cu https și fără / la final. Se citește la build (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=

# Formularul de proiect trimite e-mailuri prin serverul SMTP al găzduirii, de pe o căsuță creată în cPanel.
# Fără aceste valori, formularul NU pretinde că a trimis: îi arată vizitatorului e-mailul tău ca alternativă.
# Serverul de e-mail. Folosește numele serverului (ex. orion.hosterion.net), pentru care certificatul TLS e valid.
SMTP_HOST=
# 465 = TLS direct (implicit). 587 = STARTTLS.
SMTP_PORT=465
# Căsuța de pe care se trimite și parola ei. Parola: doar în .env.local sau în panoul găzduirii, niciodată în .env.production.
SMTP_USER=
SMTP_PASS=
# Expeditorul, aceeași căsuță ca SMTP_USER. Exemplu de format: Site Alex D. <formular@domeniul-tau.ro>
INQUIRY_FROM_EMAIL=
# Unde primești cererile.
INQUIRY_TO_EMAIL=
