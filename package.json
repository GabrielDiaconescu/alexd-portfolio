{
  "name": "alexd-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portofoliul Alex D. (Diaconescu Alexandru): web design, development și motion.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.cjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "package": "npm run build && node scripts/package-deploy.mjs",
    "deploy:plan": "node scripts/deploy-ftp.mjs plan",
    "deploy:verify": "node scripts/deploy-ftp.mjs verify"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "next": "^16.4.6",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
